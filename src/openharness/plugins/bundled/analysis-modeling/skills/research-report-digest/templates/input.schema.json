{
  "$defs": {
    "Amount": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "enum": [
                "元",
                "万元",
                "亿元",
                "千元",
                "百万元",
                "十亿元"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        },
        "missing_reason": {
          "default": "",
          "title": "Missing Reason",
          "type": "string"
        }
      },
      "required": [
        "value"
      ],
      "title": "Amount",
      "type": "object"
    },
    "BrokerReport": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "title": "Title",
          "type": "string"
        },
        "institution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Institution"
        },
        "authors": {
          "items": {
            "type": "string"
          },
          "title": "Authors",
          "type": "array"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Published At"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        },
        "summary_only": {
          "default": false,
          "title": "Summary Only",
          "type": "boolean"
        },
        "views": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Views",
          "type": "array"
        },
        "arguments": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Arguments",
          "type": "array"
        },
        "assumptions": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Assumptions",
          "type": "array"
        },
        "predictions": {
          "items": {
            "$ref": "#/$defs/Prediction"
          },
          "title": "Predictions",
          "type": "array"
        },
        "target_price": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "target_currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Currency"
        },
        "rating": {
          "$ref": "#/$defs/Rating"
        },
        "rating_change": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rating Change"
        },
        "risks": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Risks",
          "type": "array"
        },
        "gaps": {
          "items": {
            "type": "string"
          },
          "title": "Gaps",
          "type": "array"
        }
      },
      "required": [
        "title",
        "institution",
        "published_at",
        "references"
      ],
      "title": "BrokerReport",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 1,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "text",
        "references"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Company": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "code": {
          "pattern": "^\\d{6}$",
          "title": "Code",
          "type": "string"
        },
        "market": {
          "enum": [
            "SSE",
            "SZSE",
            "BSE"
          ],
          "title": "Market",
          "type": "string"
        },
        "industry": {
          "minLength": 1,
          "title": "Industry",
          "type": "string"
        },
        "financial_sector": {
          "default": false,
          "title": "Financial Sector",
          "type": "boolean"
        },
        "identity_sources": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "minItems": 1,
          "title": "Identity Sources",
          "type": "array"
        }
      },
      "required": [
        "name",
        "code",
        "market",
        "industry",
        "identity_sources"
      ],
      "title": "Company",
      "type": "object"
    },
    "Prediction": {
      "additionalProperties": false,
      "properties": {
        "year": {
          "maximum": 2100,
          "minimum": 2000,
          "title": "Year",
          "type": "integer"
        },
        "metric": {
          "title": "Metric",
          "type": "string"
        },
        "amount": {
          "$ref": "#/$defs/Amount"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "basis": {
          "minLength": 1,
          "title": "Basis",
          "type": "string"
        }
      },
      "required": [
        "year",
        "metric",
        "amount",
        "basis"
      ],
      "title": "Prediction",
      "type": "object"
    },
    "Rating": {
      "additionalProperties": false,
      "properties": {
        "current": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Current"
        },
        "previous": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous"
        },
        "change_explicit": {
          "default": false,
          "title": "Change Explicit",
          "type": "boolean"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "title": "References",
          "type": "array"
        }
      },
      "title": "Rating",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "locator": {
          "minLength": 1,
          "title": "Locator",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "source_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Id"
        },
        "page": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Page"
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "locator",
        "title"
      ],
      "title": "Reference",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "company": {
      "$ref": "#/$defs/Company"
    },
    "inputs": {
      "items": {
        "$ref": "#/$defs/Reference"
      },
      "minItems": 1,
      "title": "Inputs",
      "type": "array"
    },
    "status": {
      "default": "partial",
      "enum": [
        "complete",
        "partial",
        "blocked"
      ],
      "title": "Status",
      "type": "string"
    },
    "gaps": {
      "items": {
        "type": "string"
      },
      "title": "Gaps",
      "type": "array"
    },
    "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
    },
    "kind": {
      "const": "digest",
      "default": "digest",
      "title": "Kind",
      "type": "string"
    },
    "reports": {
      "items": {
        "$ref": "#/$defs/BrokerReport"
      },
      "minItems": 1,
      "title": "Reports",
      "type": "array"
    },
    "comparison": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Comparison",
      "type": "array"
    }
  },
  "required": [
    "company",
    "inputs",
    "as_of",
    "reports"
  ],
  "title": "DigestResult",
  "type": "object"
}
